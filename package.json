{
  "name": "pixvault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private photo toolbox that runs entirely in the browser. Nothing is uploaded.",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/build.ts --serve",
    "build": "bun scripts/build.ts",
    "check:network": "bun scripts/check-no-network.ts dist",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --deny-warnings src scripts e2e",
    "test": "bun test src scripts",
    "e2e": "playwright test",
    "fetch-models": "bun scripts/fetch-models.ts",
    "catalog": "llm-models catalog --npm callable --require openai,anthropic,google,mistral --out public/models.json"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/qoi": "^1.1.0",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "libheif-js": "^1.23.5",
    "omggif": "^1.0.10",
    "pdf-lib": "^1.17.1",
    "piexifjs": "^1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "^1.4.4",
    "@types/omggif": "^1.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "^1.90.0",
    "typescript": "7.0.2"
  }
}
