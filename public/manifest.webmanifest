{
  "name": "pixvault — private photo tools",
  "short_name": "pixvault",
  "description": "Compress, convert, resize, crop, adjust and clean your photos on your device. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "image/avif": [".avif"],
        "image/heic": [".heic", ".heif"],
        "image/jxl": [".jxl"],
        "image/gif": [".gif"],
        "image/tiff": [".tif", ".tiff"],
        "image/x-adobe-dng": [".dng"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*"] }] }
  }
}
